<?xml version="1.0"?>
<Container version="2">
  <Name>boltdiy</Name>
  <Repository>ghcr.io/stackblitz-labs/bolt.diy</Repository>
  <Network>eth0dock</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/stackblitz/labs</Support>
  <Overview>This is a bolt DIY container</Overview>
  <Category>Tools:Other</Category>
  <Environment>
    <Variable>
      <Name>TZ</Name>
      <Value>Europe/Berlin</Value>
    </Variable>
    <Variable>
      <Name>HOST_OS</Name>
      <Value>Unraid</Value>
    </Variable>
    <Variable>
      <Name>HOST_HOSTNAME</Name>
      <Value>Tower</Value>
    </Variable>
    <Variable>
      <Name>HOST_CONTAINERNAME</Name>
      <Value>boltdiy</Value>
    </Variable>
  </Environment>
  <Labels>
    <Label>
      <Name>net.unraid.docker.managed</Name>
      <Value>dockerman</Value>
    </Label>
  </Labels>
</Container>
